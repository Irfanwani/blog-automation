# Copy to .env and fill. Never commit .env.
# Publishing keys
DEVTO_API_KEY=
# Hashnode: PAT no longer works for API (retired May 2026). Connect via OAuth:
#   python cli.py hashnode-auth   -> fills HASHNODE_MCP_* below. Writes need a Pro plan.
HASHNODE_TOKEN=
HASHNODE_PUBLICATION_ID=
HASHNODE_MCP_TOKEN=
HASHNODE_MCP_REFRESH=
HASHNODE_MCP_EXPIRY=
HASHNODE_MCP_CLIENT_ID=

# X auto-post (OAuth 1.0a user context; developer.x.com app with Read+Write).
# Free-tier keys are READ-ONLY: the CLI detects 401/403 and keeps the draft
# file instead of crashing. Auto-post runs ONLY with --live.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# LLM — pick one. Default workflow uses opencode's current model (no key needed,
# you paste the prompt into opencode). Only set these if you want CLI auto-write.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_HOST=http://localhost:11434

# Identity (used for bylines + LinkedIn footer)
AUTHOR_NAME=Irfan Wani
AUTHOR_GITHUB=https://github.com/irfanwani
CANONICAL_BASE_URL=
